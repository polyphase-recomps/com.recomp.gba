# --- Game data: never commit ---------------------------------------------------------
# This package holds no game. These patterns are a safety net in case game files land here.
*.gba
*.sav
*.agbdata

# --- Build output --------------------------------------------------------------------
# Runtime/tools/check_addon.ps1 and the addon build scripts.
Runtime/build/
Build/
*.obj
*.lib
*.exp
*.ilk
*.dll
*.pdb

# --- Tooling -------------------------------------------------------------------------
__pycache__/
*.pyc
.vs/
*.vcxproj.user
# Machine-specific include paths, regenerated by the editor
# (Tools > Addons > Regenerate Native Addon Dependencies).
.vscode/
